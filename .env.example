# Base de datos SQLite
DATABASE_URL="file:./dev.db"

# URL de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Credenciales de Google Cloud OAuth 2.0 (Google Drive API)
# Obtén estas credenciales en Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3005/api/auth/google/callback"

# Credenciales de Mercado Pago (Panel de desarrolladores Mercado Pago)
MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
MERCADO_PAGO_PUBLIC_KEY="TEST-..."
MERCADO_PAGO_WEBHOOK_SECRET=""

# Contraseña de acceso al panel administrador
ADMIN_PASSWORD="cambia_esta_contraseña"
ADMIN_SESSION_SECRET="clave_secreta_para_firmar_cookies_admin"
