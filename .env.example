# Base de datos PostgreSQL (Easypanel / Supabase / Neon / Docker)
# Formato Easypanel: postgresql://<user>:<password>@<service-name>:5432/<database>?schema=public
DATABASE_URL="postgresql://postgres:password@postgres:5432/photoplus?schema=public"

# URL de la aplicación en producción (con HTTPS y sin diagonal al final)
NEXT_PUBLIC_APP_URL="https://fotos.rubenroque.com.mx"

# Credenciales de Google Cloud OAuth 2.0 (Google Drive API)
# Coloca aquí tus credenciales obtenidas en Google Cloud Console
GOOGLE_CLIENT_ID="tu-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="tu-google-client-secret"
GOOGLE_REDIRECT_URI="https://fotos.rubenroque.com.mx/api/auth/google/callback"

# Credenciales de Mercado Pago (Pruebas TEST-... o Producción APP_USR-...)
MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
MERCADO_PAGO_PUBLIC_KEY="TEST-..."
MERCADO_PAGO_WEBHOOK_SECRET=""

# Contraseña de acceso al panel administrador (/admin)
ADMIN_PASSWORD="adminphotoplus"
ADMIN_SESSION_SECRET="tu_clave_secreta_para_sesion_de_al_menos_32_caracteres"
